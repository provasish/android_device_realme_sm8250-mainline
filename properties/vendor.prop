# USB
# Early adbd needs the init trigger based gadget control (sys.usb.configfs=1),
# see device/mainline/common/docs/DEBUGGING.md.
vendor.usb.configfs=1

# Remoteproc
# The kernel DTS keeps upstream-style firmware names; on Android the split
# images are read from the mounted modem partition (see ueventd rc).
vendor.remoteproc.adsp.firmware=adsp.mdt
vendor.remoteproc.cdsp.firmware=cdsp.mdt
vendor.remoteproc.slpi.firmware=slpi.mdt
