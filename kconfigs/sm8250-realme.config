# Applied right after the arm64 defconfig.
#
# Everything here was built in on the bringup kernel that booted to
# userspace on a GT Neo 3T (RMX3371): first stage init needs storage, and the
# bootloader framebuffer needs the display clocks, before any module loads.

# Clocks, display (bootloader framebuffer through simpledrm)
CONFIG_SM_GCC_8250=y
CONFIG_SM_DISPCC_8250=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Storage
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# USB (adb). TYPEC_QCOM_PMIC sits under "if TYPEC_TCPM", so TCPM must be y.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_USB_ROLE_SWITCH=y

# Crash logs in the ramoops region (0xb0000000, same as stock)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Board peripherals (not built by the arm64 defconfig)
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_BATTERY_BQ27XXX_I2C=m
CONFIG_TYPEC_MUX_FSA4480=m
CONFIG_INPUT_AW8695_HAPTICS=m
CONFIG_SND_SOC_TFA987X=m
