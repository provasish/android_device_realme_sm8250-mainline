# Applied last. Bring back options that earlier fragments drop.
#
# TODO(maintainer): after the first build, run
#   kernel/mainline/configs/utilities/validate_kernel_config.py
# against the generated .config and list the wanted options here, each with
# a short comment (device/mainline/common/docs/KERNEL.md, "Fixups").

# The QRTR socket family must exist before qcom_q6v5_pas and ath11k probe:
# they open a QMI handle at probe time and fail for good without it. As a
# module, qrtr.ko is only loaded on request_module("net-pf-42"), which
# Android does not service, so the DSPs stayed offline. Build the core in;
# the qrtr-smd transport still loads from its rpmsg modalias.
CONFIG_QRTR=y
